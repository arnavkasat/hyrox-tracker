# ---- Supabase ----
# Project URL and publishable key (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...). Server-only. Never prefix with NEXT_PUBLIC_.
# Used by the /api/ingest endpoint and the weekly-review cron to write
# without a browser session.
SUPABASE_SECRET_KEY=

# ---- App ----
# The only address allowed to request a magic link.
ALLOWED_EMAIL=

# Optional. Only set this to pin the magic-link redirect to one origin.
# Left empty, the app uses Vercel's production domain in production and the
# request's own origin otherwise, so localhost and previews both just work.
NEXT_PUBLIC_SITE_URL=

# ---- Phase 2: Health Auto Export ----
# Bearer token the iPhone automation sends to POST /api/ingest.
# Generate with: openssl rand -hex 32
INGEST_TOKEN=

# ---- Phase 4: weekly review ----
ANTHROPIC_API_KEY=
# Vercel sends this as `Authorization: Bearer <CRON_SECRET>` on cron requests.
CRON_SECRET=
